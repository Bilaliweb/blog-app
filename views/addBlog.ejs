<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Create a Blog</title>
</head>
<body>
    <%- include('./partials/nav') %> 

    <div class="container mt-3">
        <% if (locals.blogError) { %>
            <div class="container mt-4">
              <div class="alert alert-danger" role="alert">
                <%= blogError %>
              </div>
            </div>
        <% } %>
        <form action="/blog/createBlog" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="coverImage" class="form-label">Cover Image</label>
                <input type="file" class="form-control" id="coverImage" name="coverImage">
            </div>
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" class="form-control" id="title" name="title" placeholder="Enter Title">
            </div>
            <div class="mb-3">
                <label for="description" class="form-label form-floating">Description</label>
                <textarea name="description" class="form-control" placeholder="Description here" id="description"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>

    <%- include('./partials/script') %> 
</body>
</html>