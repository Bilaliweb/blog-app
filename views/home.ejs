<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %> 
    <title>Home Page</title>
</head> 
<body>
    <%- include('./partials/nav') %> 
    
    <!-- 1. Container for proper alignment and margins -->
    <div class="container mt-5 mb-5">
        
        <!-- 2. Logic Check: Ensure blogs exist AND the array is not empty -->
        <% if (locals.user && locals.blogs && blogs.length > 0) { %>
            
            <!-- 3. The Grid Row -->
            <div class="row">
                <% blogs.forEach(blog => { %>
                    
                    <!-- 4. The Grid Columns: 
                         col-12 (1 card on mobile) 
                         col-md-6 (2 cards on tablet) 
                         col-lg-4 (3 cards on desktop) -->
                    <div class="col-12 col-md-6 col-lg-4 mb-4">
                        
                        <!-- 5. h-100 ensures the card stretches to fill the column height -->
                        <!-- <div class="card h-100 shadow-sm"> -->
                        <div class="card" style="width: 18rem;">
                            
                            <!-- Image with fixed height and object-fit so it doesn't stretch awkwardly -->
                            <img src="<%= blog.coverImageURL || '/images/default-blog.jpg' %>"  
                                 class="card-img-top" 
                                 alt="<%= blog.title %> cover image"
                                 style="height: 200px; object-fit: cover;"
                            >
                            
                            <!-- d-flex flex-column allows us to push the button to the bottom -->
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title"><%= blog.title %></h5>
                                
                                <!-- flex-grow-1 makes the paragraph take up available space, 
                                    pushing the 'Read More' button to the very bottom -->
                                <p class="card-text flex-grow-1 text-muted">
                                    <%= blog.description %>
                                </p>
                                
                                <!-- Dynamic Route Link -->
                                <a href="/blogs/<%= blog._id %>" class="btn btn-primary mt-auto">Read More</a>
                            </div>
                        </div>
                        
                    </div>
                <% }) %>
            </div>
            
        <% } else { %>
            <!-- 6. Empty State: What shows if the DB has no blogs -->
            <div class="text-center mt-5">
                <h4>No blogs found!</h4>
                <p class="text-muted">Check back later for new posts.</p>
            </div>
        <% } %>
        
    </div>

    <%- include('./partials/script') %> 
</body>
</html>